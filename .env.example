# Neon Postgres (pooled connection string)
DATABASE_URL=

# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Protects /api/cron/schedules (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Outgoing email (optional; emails are skipped when unset)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
